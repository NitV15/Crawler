{
  "name": "crawler",
  "version": "1.0.0",
  "description": "Reddit lead discovery and dealer notification system",
  "engines": {
    "node": "20.x"
  },
  "main": "server.js",
  "scripts": {
    "build": "pip install -r requirements.txt || true",
    "postinstall": "pip install -r requirements.txt || true",
    "start": "node server.js",
    "crawl": "node -e \"require('./crawler').runCrawl()\"",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.18.0",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^172.0.0",
    "groq-sdk": "^1.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "supertest": "^6.0.0"
  }
}
